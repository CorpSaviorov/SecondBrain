{
 "manifest_version":3,
 "name":"SecondBrain — прямой сбор чатов",
 "version":"0.1.0",
 "description":"Сохраняет доступные чаты ChatGPT и Claude прямо в локальную БД SecondBrain. Без Obsidian и модельных вызовов.",
 "permissions":["storage","activeTab"],
 "host_permissions":["http://127.0.0.1:8877/*"],
 "background":{"service_worker":"background.js"},
 "action":{"default_popup":"popup.html"},
 "content_scripts":[
  {"matches":["https://chatgpt.com/*","https://claude.ai/*"],"js":["bridge-main.js"],"run_at":"document_start","world":"MAIN"},
  {"matches":["https://chatgpt.com/*","https://claude.ai/*"],"js":["content.js"],"run_at":"document_start"}
 ]
}
